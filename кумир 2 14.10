алг Меню
нач
  цел н
  н := -1
  нц пока н <> 0
    вывод нс, "1.Математика 2.Массив 3.Даты 4.Оценки 5.Сортировка", нс
    вывод "6.Строки 7.Слова 8.Студенты 9.Погода 10.Геометрия 0.Выход", нс
    ввод н
    выбор
      при н = 1: математика
      при н = 2: массив
      при н = 3: даты
      при н = 4: оценки
      при н = 5: поиск
      при н = 6: строки
      при н = 7: слова
      при н = 8: студенты
      при н = 9: погода
      при н = 10: геометрия
    все
  кц
кон

алг математика
нач
  вещ таб а[1:3]
  вещ с, п, м
  цел и, к
  с := 0; п := 1; м := 0; к := 0
  вывод "Три числа:", нс
  нц для и от 1 до 3
    ввод а[и]
    с := с + а[и]
    если abs(а[и]) > м то м := abs(а[и]) все
    | По примеру задания берём положительные числа.
    если а[и] > 0 то
      п := п * а[и]; к := к + 1
    все
  кц
  вывод "Среднее: ", с / 3, нс, "Максимальное по модулю: ", м, нс
  если к > 0 то
    вывод "Геометрическое положительных: ", п ** (1.0 / к), нс
  иначе
    вывод "Положительных чисел нет.", нс
  все
кон

алг массив
нач
  цел и, х, с, к, мин, макс
  с := 0; к := 0; мин := 30; макс := -30
  нц для и от 1 до 15
    х := irand(-30, 30)
    вывод х, " "
    если х > 0 то с := с + х все
    если х < 0 то к := к + 1 все
    если х < мин то мин := х все
    если х > макс то макс := х все
  кц
  вывод нс, "Сумма положительных: ", с, нс, "Отрицательных: ", к, нс
  вывод "Минимум: ", мин, нс, "Максимум: ", макс, нс
кон

алг лог високосный(цел г)
нач
  знач := mod(г,400) = 0 или (mod(г,4) = 0 и mod(г,100) <> 0)
кон

алг цел дней(цел м, г)
нач
  знач := 31
  если м = 4 или м = 6 или м = 9 или м = 11 то знач := 30 все
  если м = 2 то
    знач := 28
    если високосный(г) то знач := 29 все
  все
кон

алг проверка даты(цел д, м, г)
нач
  утв г >= 1 и г <= 9999 и м >= 1 и м <= 12
  утв д >= 1 и д <= дней(м,г)
кон

алг цел номер(цел д, м, г)
нач
  цел и, у
  у := г - 1
  знач := 365 * у + div(у,4) - div(у,100) + div(у,400) + д - 1
  нц для и от 1 до м - 1
    знач := знач + дней(и,г)
  кц
кон

алг цел день рождения(цел д, м, г)
нач
  если д > дней(м,г) то д := дней(м,г) все
  знач := номер(д,м,г)
кон

алг лит дата(цел д, м, г)
нач
  лит сд, см
  сд := цел_в_лит(д); см := цел_в_лит(м)
  если д < 10 то сд := "0" + сд все
  если м < 10 то см := "0" + см все
  знач := цел_в_лит(г) + "-" + см + "-" + сд
кон

алг даты
нач
  цел д, м, г, дс, мс, гс, с, б, возраст
  лит таб неделя[0:6]
  неделя[0] := "понедельник"; неделя[1] := "вторник"
  неделя[2] := "среда"; неделя[3] := "четверг"
  неделя[4] := "пятница"; неделя[5] := "суббота"
  неделя[6] := "воскресенье"
  вывод "Рождение: день месяц год:", нс
  ввод д, м, г
  вывод "Сегодня: день месяц год:", нс
  ввод дс, мс, гс
  проверка даты(д,м,г); проверка даты(дс,мс,гс)
  с := номер(дс,мс,гс)
  утв номер(д,м,г) <= с
  б := день рождения(д,м,гс)
  возраст := гс - г
  если с < б то возраст := возраст - 1 все
  если б < с то б := день рождения(д,м,гс + 1) все
  вывод "День недели: ", неделя[mod(номер(д,м,г),7)], нс
  вывод "Полных лет: ", возраст, нс, "Дней до ДР: ", б - с, нс
кон

алг сортировать(аргрез цел таб а[], арг цел н)
нач
  цел и, ж, т
  нц для и от 1 до н - 1
    нц для ж от 1 до н - и
      если а[ж] > а[ж + 1] то
        т := а[ж]; а[ж] := а[ж + 1]; а[ж + 1] := т
      все
    кц
  кц
кон

алг цел сумма(цел таб а[], цел н)
нач
  цел и
  знач := 0
  нц для и от 1 до н
    знач := знач + а[и]
  кц
кон

алг вещ среднее(цел таб а[], цел н)
нач
  знач := сумма(а,н) / н
кон

алг оценки
нач
  цел таб а[1:20], ч[2:5]
  цел н, и, мода, частота
  вещ с, кв
  вывод "Количество оценок (10–20): "
  ввод н
  утв н >= 10 и н <= 20
  нц для и от 2 до 5
    ч[и] := 0
  кц
  вывод "Оценки от 2 до 5:", нс
  нц для и от 1 до н
    ввод а[и]
    утв а[и] >= 2 и а[и] <= 5
    ч[а[и]] := ч[а[и]] + 1
  кц
  с := среднее(а,н); кв := 0; частота := 0
  нц для и от 2 до 5
    если ч[и] > частота то частота := ч[и] все
  кц
  мода := 0
  нц для и от 1 до н
    кв := кв + (а[и] - с) ** 2
    если мода = 0 и ч[а[и]] = частота то мода := а[и] все
  кц
  сортировать(а,н)
  вывод "Среднее: ", с, нс
  вывод "Медиана: ", (а[div(н + 1,2)] + а[div(н,2) + 1]) / 2, нс
  вывод "Мода: ", мода, нс, "Все моды: "
  нц для и от 2 до 5
    если ч[и] = частота то вывод и, " " все
  кц
  вывод нс, "Стандартное отклонение: ", sqrt(кв / (н - 1)), нс
кон

алг поиск
нач
  цел таб а[1:20]
  цел и, х, к
  лог найден
  нц для и от 1 до 20
    а[и] := irand(-30,30)
    вывод а[и], " "
  кц
  вывод нс, "Число для поиска: "
  ввод х
  к := 0; найден := нет
  нц для и от 1 до 20
    если а[и] = х то найден := да все
    если mod(а[и],2) = 0 то к := к + 1 все
  кц
  вывод "Найдено: ", найден, нс, "Чётных: ", к, нс
  сортировать(а,20)
  вывод "По возрастанию: "
  нц для и от 1 до 20
    вывод а[и], " "
  кц
  вывод нс, "По убыванию: "
  нц для и от 20 до 1 шаг -1
    вывод а[и], " "
  кц
  вывод нс
кон

алг строки
нач
  лит с, п, замена, обратно
  цел и
  вывод "Строка: "
  ввод с
  вывод "Подстрока: "
  ввод п
  вывод "Длина: ", длин(с), нс, "Верхний регистр: ", верхний регистр(с), нс
  вывод "Позиция с 1 (0 — не найдено): ", позиция(п,с), нс
  замена := с; обратно := ""
  нц для и от 1 до длин(с)
    если с[и] = 'а' то замена[и] := '*' все
    обратно := с[и] + обратно
  кц
  вывод "Замена: ", замена, нс, "Наоборот: ", обратно, нс
кон

алг слова
нач
  лит с, слово, т
  лит таб а[1:1000]
  цел таб ч[1:1000]
  цел и, ж, н, п, лучший, к
  вывод "Текст: "
  ввод с
  с := нижний регистр(с) + " "
  слово := ""; н := 0
  нц для и от 1 до длин(с)
    если позиция("" + с[и],"abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя") > 0 то
      слово := слово + с[и]
    иначе
      если длин(слово) > 0 то
        п := 0
        нц для ж от 1 до н
          если а[ж] = слово то п := ж все
        кц
        если п = 0 то
          утв н < 1000
          н := н + 1; п := н
          а[п] := слово; ч[п] := 0
        все
        ч[п] := ч[п] + 1; слово := ""
      все
    все
  кц
  нц для и от 1 до н - 1
    нц для ж от 1 до н - и
      если а[ж] > а[ж + 1] то
        т := а[ж]; а[ж] := а[ж + 1]; а[ж + 1] := т
        к := ч[ж]; ч[ж] := ч[ж + 1]; ч[ж + 1] := к
      все
    кц
  кц
  вывод "Уникальные слова по алфавиту и их частоты:", нс
  нц для и от 1 до н
    вывод а[и], ": ", ч[и], нс
  кц
  вывод "Три самых частых:", нс
  к := н
  если к > 3 то к := 3 все
  нц к раз
    лучший := 1
    нц для и от 2 до н
      если ч[и] > ч[лучший] то лучший := и все
    кц
    вывод а[лучший], ": ", ч[лучший], нс
    ч[лучший] := -1
  кц
кон

алг студенты
нач
  цел н, и, лучший, к
  лит таб имя[1:100], группа[1:100]
  вещ таб балл[1:100]
  файл ф, р
  вывод "Количество студентов (1–100): "
  ввод н
  утв н >= 1 и н <= 100
  ф := открыть на запись("students.txt")
  вывод ф, н, нс
  нц для и от 1 до н
    вывод "ФИО: "; ввод имя[и]
    вывод "Группа: "; ввод группа[и]
    вывод "Средний балл: "; ввод балл[и]
    утв длин(имя[и]) > 0 и длин(группа[и]) > 0
    утв балл[и] >= 2 и балл[и] <= 5
    вывод ф, имя[и], нс, группа[и], нс, балл[и], нс
  кц
  закрыть(ф)
  ф := открыть на чтение("students.txt")
  ввод ф, н
  лучший := 1; к := 0
  вывод "Прочитано:", нс
  нц для и от 1 до н
    ввод ф, имя[и]
    ввод ф, группа[и]
    ввод ф, балл[и]
    вывод имя[и], " | ", группа[и], " | ", балл[и], нс
    если балл[и] > балл[лучший] то лучший := и все
    если балл[и] > 4.5 то к := к + 1 все
  кц
  закрыть(ф)
  вывод "Максимальный балл: ", имя[лучший], " — ", балл[лучший], нс
  вывод "Балл выше 4.5:", нс
  р := открыть на запись("students_filtered.txt")
  вывод р, к, нс
  нц для и от 1 до н
    если балл[и] > 4.5 то
      вывод имя[и], " | ", группа[и], " | ", балл[и], нс
      вывод р, имя[и], нс, группа[и], нс, балл[и], нс
    все
  кц
  закрыть(р)
кон

алг лит число JSON(вещ х)
нач
  лит с
  цел и
  с := вещ_в_лит(х)
  нц для и от 1 до длин(с)
    если с[и] = ',' то с[и] := '.' все
  кц
  знач := с
кон

алг погода
нач
  цел таб т[1:7]
  лит таб даты[1:7]
  цел д, м, г, и, ж, мин, макс, к
  вещ с
  лит холод, тепло
  файл ф
  вывод "Начало недели: день месяц год:", нс
  ввод д, м, г
  проверка даты(д,м,г)
  мин := 35; макс := -20; с := 0
  холод := ""; тепло := ""
  ф := открыть на запись("weather.json")
  вывод ф, '{"days":['
  вывод "Гистограмма: # = 1 градус, | = ноль.", нс
  нц для и от 1 до 7
    т[и] := irand(-20,35); даты[и] := дата(д,м,г)
    с := с + т[и]
    если т[и] < мин то мин := т[и] все
    если т[и] > макс то макс := т[и] все
    вывод даты[и], " ", т[и], " "
    нц для ж от -20 до 35
      если ж = 0 то
        вывод "|"
      иначе
        если (ж < 0 и ж >= т[и]) или (ж > 0 и ж <= т[и]) то
          вывод "#"
        иначе
          вывод " "
        все
      все
    кц
    вывод нс
    если и > 1 то вывод ф, "," все
    вывод ф, '{"date":"', даты[и], '","temperature":', т[и], "}"
    д := д + 1
    если д > дней(м,г) то
      д := 1; м := м + 1
      если м > 12 то м := 1; г := г + 1 все
    все
  кц
  нц для и от 1 до 7
    если т[и] = мин то
      если длин(холод) > 0 то холод := холод + "," все
      холод := холод + '"' + даты[и] + '"'
    все
    если т[и] = макс то
      если длин(тепло) > 0 то тепло := тепло + "," все
      тепло := тепло + '"' + даты[и] + '"'
    все
  кц
  вывод "Средняя: ", с / 7, нс, "Минимум: ", мин, нс, "Максимум: ", макс, нс
  вывод "Самые холодные дни: ", холод, нс, "Самые тёплые дни: ", тепло, нс
  вывод ф, '],"average":', число JSON(с / 7), ',"minimum":', мин
  вывод ф, ',"maximum":', макс, ',"coldest_days":[', холод
  вывод ф, '],"warmest_days":[', тепло, "]}"
  закрыть(ф)
  вывод "Сохранено: weather.json", нс
кон

алг геометрия
нач
  вещ р, а, б, в
  вывод "Радиус: "; ввод р
  утв р >= 0
  вывод "Площадь круга: ", площадь круга(р), нс
  вывод "Длина окружности: ", длина окружности(р), нс
  вывод "Объём шара: ", объём шара(р), нс
  вывод "Три стороны треугольника:", нс
  ввод а, б, в
  вывод "Площадь треугольника: ", площадь треугольника(а,б,в), нс
кон
